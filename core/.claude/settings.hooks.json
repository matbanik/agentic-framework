{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(rtk proxy git push *)",
      "Bash(git merge *)",
      "Bash(rtk proxy git merge *)",
      "Bash(git tag *)",
      "Bash(rtk proxy git tag *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/commit_gate.py\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/credits_inbox.py\"" }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/tools/stop_gate.py\" \"${CLAUDE_PROJECT_DIR}\"" }] },
      { "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/credits_inbox.py\"" }] }
    ]
  }
}
