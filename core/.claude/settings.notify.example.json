{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/tools/agent_notify.py\" hook --harness claude",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/tools/agent_notify.py\" hook --harness claude",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/tools/agent_notify.py\" hook --harness claude",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ]
  }
}
